# Local MySQL from docker-compose.yml (root is used so Prisma can create its shadow database)
DATABASE_URL="mysql://root:root@localhost:3306/movieTicket"
PORT=3000
JWT_SECRET="change-me"
# Separate database for integration tests (all data is deleted on every test run)
TEST_DATABASE_URL="mysql://root:root@localhost:3306/movieTicket_test"
